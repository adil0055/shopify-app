// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// PostgreSQL database - more reliable than SQLite for development
// Set DATABASE_URL in your .env file
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlanTier {
  FREE
  PRO
  ENTERPRISE
}

enum VtoEventType {
  /// User clicked the Try On button (storefront redirect out).
  REDIRECT_OUT

  /// Future: external frontend initiated a VTO job.
  VTO_JOB_REQUEST

  /// Future: job completed successfully.
  VTO_JOB_SUCCESS

  /// Future: job failed.
  VTO_JOB_FAILURE
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model ApiCallLog {
  id        String       @id @default(cuid())
  shop      String
  createdAt DateTime     @default(now())

  /// High-level event type. In Phase 2 these can be sample records.
  eventType VtoEventType

  /// Success/failure status for analytics.
  isSuccess Boolean

  /// Non-sensitive debug context (never store PII).
  requestId String?
  message   String?
  metadata  Json?

  @@index([shop, createdAt])
  @@index([shop, eventType, createdAt])
}
